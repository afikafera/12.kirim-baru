[Unit]
Description=Hermes HTTPS reverse proxy
After=network-online.target hermes.service
Wants=network-online.target hermes.service

[Service]
Type=simple
User=arman
Group=arman
WorkingDirectory=/var/lib/hermes-caddy
Environment=XDG_DATA_HOME=/var/lib/hermes-caddy/data
Environment=XDG_CONFIG_HOME=/var/lib/hermes-caddy/config
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-caddy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
