[Unit]
Description=Hermes authenticated staging API
After=network.target

[Service]
Type=simple
User=arman
Group=arman
WorkingDirectory=/home/arman/research-assistant
EnvironmentFile=/etc/hermes/auth.env
ExecStart=/home/arman/research-assistant/venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8001 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
